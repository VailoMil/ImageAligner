<Window x:Class="ImageAligner.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ImageAligner — Blacksad"
        Height="820" Width="1400"
        MinHeight="600" MinWidth="1000"
        WindowStartupLocation="CenterScreen">

    <Window.InputBindings>
        <KeyBinding Key="F1"  Command="{Binding HelpCommand}"/>
        <KeyBinding Key="F11" Command="{Binding OpenFullscreenCommand}" CommandParameter="result"/>
        <KeyBinding Key="O"   Command="{Binding OpenCommand}"   Modifiers="Control"/>
        <KeyBinding Key="S"   Command="{Binding SaveCommand}"   Modifiers="Control"/>
        <KeyBinding Key="Z"   Command="{Binding ResetCommand}"  Modifiers="Control"/>
        <KeyBinding Key="D"   Command="{Binding DetectCommand}"/>
        <KeyBinding Key="A"   Command="{Binding AlignCommand}"/>
        <KeyBinding Key="C"   Command="{Binding CropCommand}"/>
        <KeyBinding Key="R"   Command="{Binding RotateCommand}"/>
    </Window.InputBindings>

    <DockPanel>

        <Border DockPanel.Dock="Top" BorderBrush="{StaticResource BorderDimBrush}"
                BorderThickness="0,0,0,1" Background="{StaticResource BgBrush}">
            <Menu Background="Transparent">
                <MenuItem Header="_Файл">
                    <MenuItem Header="_Открыть…"   Command="{Binding OpenCommand}"  InputGestureText="Ctrl+O"/>
                    <MenuItem Header="_Сохранить…" Command="{Binding SaveCommand}"  InputGestureText="Ctrl+S"/>
                    <Separator/>
                    <MenuItem Header="С_бросить"   Command="{Binding ResetCommand}" InputGestureText="Ctrl+Z"/>
                    <Separator/>
                    <MenuItem Header="_Выход" Click="OnExitClick"/>
                </MenuItem>
                <MenuItem Header="_Изображение">
                    <MenuItem Header="Найти _контуры" Command="{Binding DetectCommand}"          InputGestureText="D"/>
                    <MenuItem Header="_Выровнять"     Command="{Binding AlignCommand}"           InputGestureText="A"/>
                    <MenuItem Header="Об_резать"      Command="{Binding CropCommand}"            InputGestureText="C"/>
                    <MenuItem Header="_Повернуть…"    Command="{Binding RotateCommand}"          InputGestureText="R"/>
                    <MenuItem Header="Убрать _фон"    Command="{Binding RemoveBackgroundCommand}"/>
                </MenuItem>
                <MenuItem Header="_Вид">
                    <MenuItem Header="Открыть в _окне"
                              Command="{Binding OpenPreviewCommand}"
                              CommandParameter="result"/>
                    <MenuItem Header="Во _весь экран"
                              Command="{Binding OpenFullscreenCommand}"
                              CommandParameter="result"
                              InputGestureText="F11"/>
                </MenuItem>
                <MenuItem Header="_Справка">
                    <MenuItem Header="Управление и параметры" Command="{Binding HelpCommand}" InputGestureText="F1"/>
                    <MenuItem Header="О программе" Click="OnAboutClick"/>
                </MenuItem>
            </Menu>
        </Border>

        <Border DockPanel.Dock="Bottom"
                BorderBrush="{StaticResource BorderDimBrush}"
                BorderThickness="0,1,0,0"
                Background="{StaticResource PanelBrush}">
            <Grid Margin="16,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Status}"
                           Foreground="{StaticResource MutedTextBrush}"
                           FontStyle="Italic"
                           VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1"
                           Text="{Binding Settings.Mode, StringFormat=РЕЖИМ · {0}}"
                           Foreground="{StaticResource AccentDimBrush}"
                           FontSize="11"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <Border DockPanel.Dock="Left" Width="240"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderDimBrush}"
                BorderThickness="0,0,1,0">
            <DockPanel>

                <Border DockPanel.Dock="Top" Margin="20,24,20,20">
                    <StackPanel>
                        <TextBlock Text="B L A C K S A D"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource AccentBrush}"/>
                        <TextBlock Text="ДЕТЕКТИВНОЕ АГЕНТСТВО"
                                   FontSize="10"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   Margin="0,6,0,0"/>
                        <TextBlock Text="ЛАБОРАТОРИЯ ИЗОБРАЖЕНИЙ"
                                   FontSize="9"
                                   Foreground="{StaticResource AccentDimBrush}"
                                   Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <Border DockPanel.Dock="Top" Height="1"
                        Background="{StaticResource BorderDimBrush}" Margin="20,0"/>

                <StackPanel Margin="12,16">
                    <Button Style="{StaticResource MenuButton}" Command="{Binding OpenCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📂" FontSize="15" Width="28"/>
                            <TextBlock Text="Открыть" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource MenuButton}" Command="{Binding DetectCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔍" FontSize="15" Width="28"/>
                            <TextBlock Text="Найти контуры" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource MenuButton}" Command="{Binding AlignCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📐" FontSize="15" Width="28"/>
                            <TextBlock Text="Выровнять" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource MenuButton}" Command="{Binding CropCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="✂" FontSize="15" Width="28"/>
                            <TextBlock Text="Обрезать" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource MenuButton}" Command="{Binding RotateCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔄" FontSize="15" Width="28"/>
                            <TextBlock Text="Повернуть" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource MenuButton}" Command="{Binding RemoveBackgroundCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🧹" FontSize="15" Width="28"/>
                            <TextBlock Text="Убрать фон" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Border Height="1" Background="{StaticResource BorderDimBrush}" Margin="12,10"/>

                    <Button Style="{StaticResource MenuButton}"
                            Command="{Binding OpenPreviewCommand}"
                            CommandParameter="result">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🖼" FontSize="15" Width="28"/>
                            <TextBlock Text="Открыть в окне" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource MenuButton}"
                            Command="{Binding OpenFullscreenCommand}"
                            CommandParameter="result">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⛶" FontSize="15" Width="28"/>
                            <TextBlock Text="Во весь экран" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource MenuButton}" Command="{Binding ResetCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="↺" FontSize="15" Width="28"/>
                            <TextBlock Text="Сбросить" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource MenuButton}" Command="{Binding SaveCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="💾" FontSize="15" Width="28"/>
                            <TextBlock Text="Сохранить" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <Border DockPanel.Dock="Right" Width="280"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderDimBrush}"
                BorderThickness="1,0,0,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="20,24">

                    <TextBlock Text="МУЗЫКА"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource AccentBrush}"
                               Margin="0,0,0,4"/>
                    <TextBlock Text="звуковое сопровождение"
                               FontSize="10"
                               FontStyle="Italic"
                               Foreground="{StaticResource MutedTextBrush}"
                               Margin="0,0,0,12"/>

                    <CheckBox Content="Включить музыку"
                              IsChecked="{Binding IsMusicEnabled}"/>

                    <TextBlock Text="Трек" Foreground="{StaticResource MutedTextBrush}"
                               FontSize="11" Margin="0,8,0,4"/>

                    <Button Content="Спокойная (детектив)"
                            Command="{Binding SetTrackCommand}"
                            CommandParameter="Calm"
                            Margin="0,2"/>
                    <Button Content="Погоня"
                            Command="{Binding SetTrackCommand}"
                            CommandParameter="Chase"
                            Margin="0,2"/>
                    <Button Content="Нуар (джаз)"
                            Command="{Binding SetTrackCommand}"
                            CommandParameter="Noir"
                            Margin="0,2"/>

                    <TextBlock Text="Громкость" Foreground="{StaticResource MutedTextBrush}"
                               FontSize="11" Margin="0,8,0,4"/>
                    <Slider Minimum="0" Maximum="1"
                            Value="{Binding MusicVolume}"
                            TickFrequency="0.1"
                            Margin="0,0,0,4"/>

                    <Border Height="1" Background="{StaticResource BorderDimBrush}" Margin="0,16"/>

                    <Expander IsExpanded="True"
                              Foreground="{StaticResource AccentBrush}"
                              BorderBrush="{StaticResource BorderDimBrush}"
                              BorderThickness="0">
                        <Expander.Header>
                            <StackPanel Margin="0,0,0,8">
                                <TextBlock Text="НАСТРОЙКИ"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource AccentBrush}"/>
                                <TextBlock Text="параметры расследования"
                                           FontSize="10"
                                           FontStyle="Italic"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           Margin="0,2,0,0"/>
                            </StackPanel>
                        </Expander.Header>

                        <StackPanel Margin="0,8,0,0">

                            <TextBlock Text="Режим работы" Foreground="{StaticResource MutedTextBrush}"
                                       FontSize="11" Margin="0,4,0,4"/>
                            <ComboBox SelectedValue="{Binding Settings.Mode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      SelectedValuePath="Content"
                                      Margin="0,0,0,12">
                                <ComboBoxItem Content="SemiAuto"/>
                                <ComboBoxItem Content="Auto"/>
                                <ComboBoxItem Content="Manual"/>
                            </ComboBox>

                            <TextBlock Text="Формат сохранения" Foreground="{StaticResource MutedTextBrush}"
                                       FontSize="11" Margin="0,4,0,4"/>
                            <ComboBox SelectedValue="{Binding SaveFormat, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      SelectedValuePath="Content"
                                      Margin="0,0,0,12">
                                <ComboBoxItem Content="PNG"/>
                                <ComboBoxItem Content="JPEG"/>
                                <ComboBoxItem Content="BMP"/>
                                <ComboBoxItem Content="TIFF"/>
                            </ComboBox>

                            <TextBlock Text="Padding, px" Foreground="{StaticResource MutedTextBrush}"
                                       FontSize="11" Margin="0,4,0,4"/>
                            <TextBox Text="{Binding OuterPadding}" Margin="0,0,0,12"/>

                            <TextBlock Text="MaxWorkingSize" Foreground="{StaticResource MutedTextBrush}"
                                       FontSize="11" Margin="0,4,0,4"/>
                            <TextBox Text="{Binding Settings.MaxWorkingSize}" Margin="0,0,0,12"/>

                            <TextBlock Text="MinContourAreaRatio" Foreground="{StaticResource MutedTextBrush}"
                                       FontSize="11" Margin="0,4,0,4"/>
                            <TextBox Text="{Binding Settings.MinContourAreaRatio}" Margin="0,0,0,12"/>

                            <CheckBox Content="Авто-выравнивание при открытии"
                                      IsChecked="{Binding AutoAlignOnOpen}"/>
                            <CheckBox Content="Убирать фон после выравнивания"
                                      IsChecked="{Binding RemoveBackgroundAfterAlign}"/>

                            <Button Content="СОХРАНИТЬ НАСТРОЙКИ"
                                    Command="{Binding SaveSettingsCommand}"
                                    FontSize="11"
                                    Margin="0,20,0,0"/>
                        </StackPanel>
                    </Expander>

                </StackPanel>
            </ScrollViewer>
        </Border>

        <Grid Margin="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="ИСХОДНИК"
                       HorizontalAlignment="Center" Margin="0,4,0,8"
                       Foreground="{StaticResource MutedTextBrush}"
                       FontSize="11" FontWeight="SemiBold"/>
            <TextBlock Grid.Row="0" Grid.Column="1" Text="КОНТУРЫ"
                       HorizontalAlignment="Center" Margin="0,4,0,8"
                       Foreground="{StaticResource MutedTextBrush}"
                       FontSize="11" FontWeight="SemiBold"/>
            <TextBlock Grid.Row="0" Grid.Column="2" Text="РЕЗУЛЬТАТ"
                       HorizontalAlignment="Center" Margin="0,4,0,8"
                       Foreground="{StaticResource MutedTextBrush}"
                       FontSize="11" FontWeight="SemiBold"/>

            <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource CardBorder}">
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftDoubleClick"
                                  Command="{Binding OpenPreviewCommand}"
                                  CommandParameter="source"/>
                </Border.InputBindings>
                <Image Source="{Binding SourceImage}" Stretch="Uniform" Margin="6"/>
            </Border>
            <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource CardBorder}">
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftDoubleClick"
                                  Command="{Binding OpenPreviewCommand}"
                                  CommandParameter="contour"/>
                </Border.InputBindings>
                <Image Source="{Binding ContourImage}" Stretch="Uniform" Margin="6"/>
            </Border>
            <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource CardBorder}">
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftDoubleClick"
                                  Command="{Binding OpenPreviewCommand}"
                                  CommandParameter="result"/>
                </Border.InputBindings>
                <Image Source="{Binding ResultImage}" Stretch="Uniform" Margin="6"/>
            </Border>
        </Grid>
    </DockPanel>
</Window>