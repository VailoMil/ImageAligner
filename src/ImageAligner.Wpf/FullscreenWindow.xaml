<Window x:Class="ImageAligner.Wpf.FullscreenWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ImageAligner — Blacksad"
        WindowStyle="None"
        WindowState="Maximized"
        ResizeMode="NoResize"
        Background="#FF0A0D11">

    <Grid>
        <Image Source="{Binding Image}" Stretch="Uniform" Margin="40,60,40,40"/>

        <Border VerticalAlignment="Top" Height="56"
                Background="#CC000000"
                BorderBrush="#FF3A3428" BorderThickness="0,0,0,1">
            <Grid Margin="24,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Title}"
                           Foreground="#FFC9A45C"
                           FontSize="14"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <TextBlock Text="Esc — выход"
                               Foreground="#FF8A8578"
                               VerticalAlignment="Center"
                               Margin="0,0,20,0"
                               FontStyle="Italic"/>
                    <Button Content="✕" Width="36" Height="32"
                            Command="{Binding CloseCommand}"
                            Background="Transparent"
                            Foreground="#FFC9A45C"
                            BorderBrush="#FFC9A45C"
                            BorderThickness="1"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>